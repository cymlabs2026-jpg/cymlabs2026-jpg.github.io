# Videos y archivos de trabajo: pesan mucho y no van a Git
proyectos/*
!proyectos/.gitkeep
plantillas/musica/*
!plantillas/musica/.gitkeep

# Claves
.env

# Python
__pycache__/
*.egg-info/
.venv/
venv/
.pytest_cache/

# Renders de los ejemplos (se regeneran con sus scripts)
ejemplos/*/version_animada/trabajo/
ejemplos/*/version_animada/previa/
ejemplos/*/version_animada/*.mp4
ejemplos/*/version_animada/video_01_tu_voz.srt
ejemplos/*/version_animada/cierre_foto.*
